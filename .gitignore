# macOS
.DS_Store

# Local databases, backups and runtime files stay on each machine.
data/*
!data/demo.json
# 例外：data/.htaccess 是访问拦截规则，必须随仓库分发
!data/.htaccess

# 日志
*.log

# Local IDE configuration
.idea/

# 图标缓存：lib/favicon.php 抓取后落盘，属运行时产物，缓存目录会自动创建
assets/icons/*

# 工作区元数据与文档打包产物
.workbuddy/
docs/user-stories.zip
